<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="16dp">

    <!--tekst wyszukiwania-->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="Szukaj:"/>

        <EditText
            android:id="@+id/edtSzukaj"
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:hint="Imię lub nazwisko"
            android:inputType="text"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="Sortowanie:"/>

        <RadioGroup
            android:id="@+id/rgSortowanie"
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:checkedButton="@id/rbRosnaco">

            <RadioButton
                android:id="@+id/rbRosnaco"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rosnąco"/>

            <RadioButton
                android:id="@+id/rbMalejaco"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Malejąco"/>
        </RadioGroup>
    </LinearLayout>

    <!--przyciski-->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/btnWrocFiltr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="Wróć"/>

        <Button
            android:id="@+id/btnZastosuj"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zastosuj"/>

    </LinearLayout>

</LinearLayout>